{
  "name": "@squircle-icons/homepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "generate": "node --import tsx tools/generate-catalog.ts",
    "generate:check": "node --import tsx tools/generate-catalog.ts --check",
    "dev": "pnpm generate && vite dev --host 127.0.0.1",
    "build": "pnpm generate && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "playwright test",
    "test:browser": "playwright test",
    "dependency:check": "node tools/dependency-check.mjs",
    "sync:svelte": "node tools/sync-svelte.mjs",
    "verify": "pnpm format:check && pnpm dependency:check && pnpm generate:check && pnpm check && pnpm build && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@squircle-icons/svelte": "file:vendor/squircle-icons-svelte-0.1.0-alpha.0.tgz"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "description": "The Squircle Icons SvelteKit website, gallery and documentation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/squircle-icons/homepage.git"
  },
  "homepage": "https://github.com/squircle-icons/homepage#readme",
  "bugs": {
    "url": "https://github.com/squircle-icons/homepage/issues"
  }
}
